#!/bin/bash
#PBS -q workq
#PBS -l nodes=1:ppn=1
#PBS -j oe
#PBS -V
#PBS -N save_gaze_weight_99main
#PBS -J 1-254

##############################################################################
# PBS Array Job: Calculate Gaze Weights for Movie Frames
##############################################################################
#
# Purpose:
#   Submits parallel jobs to calculate Gaussian gaze attention weights
#   for all subjects passing quality control filters.
#
# Usage:
#   qsub 05_prepare_reg_0save_gaze_weight_pbs.pbs
#
# Parameters to modify:
#   - MOVIE: Set to 'TP' or 'DM'
#   - HX_DOCU: Set to 'True' or 'False'
#   - PBS -J: Adjust range based on number of subjects in id_list file
#
# Notes:
#   - Each array job processes one subject
#   - Subject IDs are read from id_list_inc_byhx_docu-${HX_DOCU}.txt
#   - Output: Gaze weight .npy files per subject per frame
#
# To fix errors caused by Windows-style line endings, run:
#   1) Open the file: vim your_script_name.sh
#   2) Type :set ff=unix and press Enter.
#   3) Type :wq and press Enter to save and quit.
##############################################################################

# Basic settings
# Project root.  Set ASC_PROJECT_ROOT to the value of roots.project in
# config/paths.yml; the original hard-coded lab mount point is not distributed.
readonly BASEDIR="${ASC_PROJECT_ROOT:?set ASC_PROJECT_ROOT to the project root (see config/paths.yml)}"
CODEDIR=${BASEDIR}/1_code/99_main
PIPELINE=99_main
TASK=05_prepare_reg

# User-configurable parameters
MOVIE=TP         # Movie condition: 'TP' (The Present; N=254) or 'DM' (Despicable Me; N=246)
HX_DOCU=True    # ASD by-history documentation filter

# Job execution
SCRIPT=${CODEDIR}/05_prepare_reg_0save_gaze_weight_sub.py

# Get subject ID from array index
JOB_NO=$PBS_ARRAY_INDEX
if [ "${MOVIE}" = "TP" ]; then
    readonly ID_LIST_FILE="${BASEDIR}/2_pipeline/${PIPELINE}/${TASK}/save/id_list_TP_inc_byhx_docu-${HX_DOCU}.txt"
else
    readonly ID_LIST_FILE="${BASEDIR}/2_pipeline/${PIPELINE}/${TASK}/save/id_list_inc_byhx_docu-${HX_DOCU}.txt"
fi
readonly SUB_ID=$(sed -n "${JOB_NO} p" "${ID_LIST_FILE}")

# Print job information
echo "========================================="
echo "PBS Array Job: Gaze Weight Calculation"
echo "========================================="
echo "Job ID: $PBS_JOBID"
echo "Array Index: $PBS_ARRAY_INDEX"
echo "Subject ID: $SUB_ID"
echo "Movie: $MOVIE"
echo "HX Documentation Filter: $HX_DOCU"
echo "Node: $(hostname)"
echo "Start time: $(date)"
echo "========================================="
echo ""

# Run Python script
runprogram() {
    python3 ${SCRIPT} ${SUB_ID} ${MOVIE} ${HX_DOCU}
}

runprogram

# Print completion message
EXIT_CODE=$?
echo ""
echo "========================================="
echo "Job completed at: $(date)"
echo "Exit code: $EXIT_CODE"
echo "========================================="

exit $EXIT_CODE
