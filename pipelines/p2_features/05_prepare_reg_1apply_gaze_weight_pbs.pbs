#!/bin/bash
#PBS -q workq
#PBS -l nodes=1:ppn=1
#PBS -j oe
#PBS -V
#PBS -N apply_gaze_weight
#PBS -J 1-254

# =============================================================================
# APPLY GAZE WEIGHTS TO SEMANTIC REGRESSORS
# =============================================================================
#
# This PBS script submits an array job to apply pre-computed gaze attention
# weights to semantic regressor matrices. Each array job processes one subject
# in parallel.
#
# Reference:
#   - Source: S:\jelee\02_asd_semantic_map\1_code\17_param_search\00_prepare_data_release11_3apply_gaze_weight_inc_byhx_pbs.pbs
#   - Python script: 05_prepare_reg_1apply_gaze_weight_sub.py
#
# Project: 02_asd_semantic_map
# Pipeline: 99_main
# Task: 05_prepare_reg
#
# To fix errors caused by Windows-style line endings, run:
#   1) Open the file: vim your_script_name.sh
#   2) Type :set ff=unix and press Enter.
#   3) Type :wq and press Enter to save and quit.
#
# =============================================================================

# =============================================================================
# PROJECT CONFIGURATION
# =============================================================================

# Project paths
# Project root.  Set ASC_PROJECT_ROOT to the value of roots.project in
# config/paths.yml; the original hard-coded lab mount point is not distributed.
readonly BASEDIR="${ASC_PROJECT_ROOT:?set ASC_PROJECT_ROOT to the project root (see config/paths.yml)}"
readonly CODEDIR="${BASEDIR}/1_code"
readonly PIPELINE="99_main"
readonly TASK="05_prepare_reg"

# =============================================================================
# ANALYSIS PARAMETERS
# =============================================================================

# Movie selection
readonly MOVIE="TP"              # Options: TP (The Present; N=254), DM (Despicable Me; N=246)

# Encoding model setting
readonly SETTING="within"        # Options: cross (DM→TP), within (DM→DM)

# Subject filtering
readonly HX_DOCU="True"         # Options: True (require documentation for ASD by-history, N=246),
                                 #          False (include all ASD by-history, N=267)

# Gaze weighting parameters
readonly BIAS_WEIGHT="0.9"       # Bias weight for noun labels (0-1 range)
                                 # Higher = more influence from original regressors
                                 # Lower = more influence from gaze weighting

readonly VERB_WEIGHT="1.0"       # Weight multiplier for verb labels (0-1 range)
                                 # Scales action/verb regressor values

# =============================================================================
# SCRIPT PATHS
# =============================================================================

# Python script to execute
readonly SCRIPT="${CODEDIR}/${PIPELINE}/${TASK}_1apply_gaze_weight_sub.py"

# Subject ID list (filtered by hx_docu parameter)
if [ "${MOVIE}" = "TP" ]; then
    readonly ID_LIST_FILE="${BASEDIR}/2_pipeline/${PIPELINE}/${TASK}/save/id_list_TP_inc_byhx_docu-${HX_DOCU}.txt"
else
    readonly ID_LIST_FILE="${BASEDIR}/2_pipeline/${PIPELINE}/${TASK}/save/id_list_inc_byhx_docu-${HX_DOCU}.txt"
fi

# =============================================================================
# JOB ARRAY PROCESSING
# =============================================================================

# Get subject ID from array index
readonly JOB_NO="${PBS_ARRAY_INDEX}"
readonly SUB_ID=$(sed -n "${JOB_NO} p" "${ID_LIST_FILE}")

# Validate subject ID
if [ -z "${SUB_ID}" ]; then
    echo "ERROR: Could not read subject ID for array index ${JOB_NO}"
    echo "       Check ID list file: ${ID_LIST_FILE}"
    exit 1
fi

# =============================================================================
# JOB EXECUTION
# =============================================================================

echo "========================================="
echo "PBS Job Configuration"
echo "========================================="
echo "Job ID: ${PBS_JOBID}"
echo "Array Index: ${PBS_ARRAY_INDEX}"
echo "Subject: ${SUB_ID}"
echo "Movie: ${MOVIE}"
echo "Setting: ${SETTING}"
echo "By-history docu filter: ${HX_DOCU}"
echo "Bias weight: ${BIAS_WEIGHT}"
echo "Verb weight: ${VERB_WEIGHT}"
echo "========================================="
echo ""

# Run Python script
python3 "${SCRIPT}" \
    "${SUB_ID}" \
    "${MOVIE}" \
    "${SETTING}" \
    "${HX_DOCU}" \
    --bias_weight "${BIAS_WEIGHT}" \
    --verb_weight "${VERB_WEIGHT}"

# Capture exit code
exit_code=$?

echo ""
echo "========================================="
if [ ${exit_code} -eq 0 ]; then
    echo "SUCCESS: Gaze weights applied for ${SUB_ID}"
else
    echo "ERROR: Script failed with exit code ${exit_code}"
fi
echo "========================================="

exit ${exit_code}
